{
    "name": "pocket-chatgpt-images",
    "version": "1.2.0",
    "private": true,
    "description": "Owner-operated ChatGPT image generation for Pi Pocket through the native Codex CLI",
    "repository": {
        "type": "git",
        "url": "https://github.com/meydjer/pi-pocket-chatgpt-images.git"
    },
    "author": {
        "name": "Meydjer Luzzoli",
        "url": "https://github.com/meydjer"
    },
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24.22.1"
    },
    "scripts": {
        "setup:pocket": "node scripts/setup-pi-pocket.mjs",
        "verify:pocket": "node scripts/verify-pi-pocket.mjs",
        "precheck": "npm run verify:pocket",
        "check": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "pretest": "npm run verify:pocket",
        "test": "node --test *.test.ts",
        "smoke:live": "node scripts/smoke-live.mjs",
        "validate": "npm run format:check && npm run check && npm run lint && npm test"
    },
    "peerDependencies": {
        "@earendil-works/chord": "1.5.2",
        "@earendil-works/pi-ai": "1.5.2",
        "@earendil-works/pi-durable": "1.5.2",
        "@earendil-works/pi-schema": "1.5.2"
    },
    "devDependencies": {
        "@earendil-works/chord": "1.5.2",
        "@earendil-works/pi-ai": "1.5.2",
        "@earendil-works/pi-codemode": "1.5.2",
        "@earendil-works/pi-coding-agent": "1.5.2",
        "@earendil-works/pi-durable": "1.5.2",
        "@earendil-works/pi-mcp": "1.5.2",
        "@earendil-works/pi-schema": "1.5.2",
        "@types/node": "24.19.2",
        "dompurify": "3.4.17",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "heic-convert": "2.1.0",
        "htm": "3.1.1",
        "jiti": "2.7.0",
        "katex": "0.19.1",
        "marked": "18.1.1",
        "minimatch": "11.0.8",
        "pele": "1.13.0",
        "preact": "11.0.2",
        "prettier": "3.9.10",
        "qrcode": "1.5.4",
        "typebox": "1.3.27",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "undici": "8.12.3"
    },
    "overrides": {
        "undici": "$undici",
        "@typescript-eslint/typescript-estree": {
            "minimatch": "$minimatch"
        }
    }
}
